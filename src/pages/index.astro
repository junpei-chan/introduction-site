---
import BaseLayout from "../layouts/base-layout.astro";
import Header from "../components/shared/header.astro";

import HeroSection from "../components/top/hero-section.astro";
import AboutSection from "../components/top/about/about-section.astro";
import ProfileSection from "../components/top/profile/profile-section.astro";
import HobbySection from "../components/top/hobby/hobby-section.astro";
import MessageSection from "../components/top/message/message-section.astro";
---

<BaseLayout title="Nana First">
	<Header />

	<div class="relative">
		<HeroSection />

		<img
			src="/images/global/texture/bg-wave.svg"
			alt=""
			class="absolute -bottom-85 left-0 w-full z-0"
		/>
	</div>
	<AboutSection />
	<ProfileSection />
	<HobbySection />
	<MessageSection />
</BaseLayout>
