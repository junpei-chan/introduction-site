---
import Image from "astro/components/Image.astro";

interface Props {
  tapePosition: "left" | "center" | "right";
  imagePath: string;
  text: string;
  className?: string;
}

const { tapePosition, imagePath, text, className } = Astro.props;

const tapeType = tapePosition === "center" 
  ? "yellow"
  : "blue";

const tapeStyle = tapePosition === "left"
  ? "-top-8 -left-6 rotate-90" // left style
  : tapePosition === "center"
    ? "-top-12 left-14 rotate-40" // center style
    : "-top-8 -right-2 -rotate-10"; // right style
---

<div class={`${className}`}>
  <Image 
    src={`/images/global/${tapeType}-tape.svg`}
    alt=""
    width={96}
    height={104}
    class={`
      absolute
      ${tapeStyle}
    `}
  />
  <div class="flex flex-col items-center gap-4 w-54 p-4 bg-off-white shadow-[4px_4px_4px_2px_rgba(98,162,153,0.25)]">
    <Image 
      src={`/images/nakayama/${imagePath}`}
      alt={text}
      width={160}
      height={160}
      class="rounded-lg"
    />
    <p class="heading-jiyucho-20 text-turquoise-blue-500 text-center">
      {text}
    </p>
    <svg width="100%" height="4">
    <line
      x1="0" y1="2" x2="100%" y2="2"
      stroke="#91D1C9"
      stroke-width="3"
      stroke-dasharray="8 8"
      stroke-linecap="round"
    />
  </svg>
  </div>
</div>