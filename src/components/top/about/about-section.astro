---
import AboutCard from "./about-card.astro";
---

<section class="relative pt-32 pb-40 overflow-hidden">
    <div class="flex flex-col items-center gap-3 mb-16">
        <h2 class="heading-zenmaru-32 text-soft-black">わたしのこと</h2>

        <div class="flex items-center gap-6">
            <img
                src="/images/top/about/leaf_left.svg"
                alt=""
                class="relative -top-7 w-32 opacity-80"
            />
            <p class="body-14-regular text-soft-black">ABOUT</p>

            <img
                src="/images/top/about/leaf_right.svg"
                alt=""
                class="relative -top-7 w-32 opacity-80"
            />
        </div>

        <!-- ３つのカード -->
        <div class="flex justify-center gap-6.25 relative z-10">
            <AboutCard
                image="/images/top/about/favorite_img.svg"
                title="好きなもの"
                highlight="好"
                text={`わたしの小さな宝箱。
            共通点を探そう！`}
                color="turquoise"
                link="/favorite"
            />

            <AboutCard
                image="/images/top/about/personality_img.svg"
                title="性格について"
                highlight="性格"
                text={`みんなから「ポワポワ」
            していると言われます。`}
                color="yellow"
                link="/profile"
            />

            <AboutCard
                image="/images/top/about/diagnosis_img.svg"
                title="相性診断"
                highlight="相性"
                text={`私との相性を
            確かめてみませんか？`}
                color="pink"
                link="/diagnosis"
            />
        </div>
    </div>
</section>
